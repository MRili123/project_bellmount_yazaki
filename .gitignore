# Model files (users create/download their own)
models/mesure/*.h5
models/state/*.h5

# Screenshots and test images
screenshot/
screenshots/
test_viz_*.png
*.png
test_images/
model_bellmounth_mesure/screenshots/
model_bellmounth_mesure/captured/
model_bellmounth_mesure/dataset/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# IDE and OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Claude Code local config
.claude/

# Large local model backups (too big for GitHub / not needed in repo)
model_backups/
*.h5.bak

# Stale DB backups and logs
*.stale-bak
*.log

# Secrets — never commit
.env
.cloud_token.json

# Build artifacts (PyInstaller + Inno Setup) — multi-GB, never commit
build/
dist/
*.spec
*.exe

# Local SQLite dev database
bellmounth.db
*.db

# Runtime cache (regenerated from the API each run)
admin_cache.json

# Markdown docs (kept locally, not tracked in the repo)
*.md
