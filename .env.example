# DATABASE
# For SQLite (local development):
DATABASE_URL=sqlite:///./bellmounth.db

# For Azure SQL (production):
# DATABASE_URL=mssql+pyodbc://azadmin:password@bellmounth-server.database.windows.net/bellmounth-db?driver=ODBC+Driver+17+for+SQL+Server

# IMAGE STORAGE
# For local filesystem:
CAPTURES_DIR=./captures

# For Azure Blob Storage (production):
# BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...

# SECURITY
JWT_SECRET=your-super-secret-jwt-key-change-in-production-12345
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# API
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:8000", "http://127.0.0.1:8000"]
