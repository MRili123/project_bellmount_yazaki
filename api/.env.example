# ------------------------------------------------------------------------------
# Bellmounth API — environment variables
# Local dev: copy to `.env` (values below already work for local SQLite + disk).
# Azure: set these in App Service -> Configuration -> Environment variables.
# ------------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Local (default if unset):
#   sqlite:///./bellmounth.db
# Azure PostgreSQL (recommended):
#   postgresql://USER:PASSWORD@HOST:5432/bellmounth
# Azure SQL: paste the portal's ADO.NET string as-is; the app wraps it for pyodbc:
#   Server=tcp:xxx.database.windows.net,1433;Initial Catalog=bellmounth-db;User ID=azadmin;Password=...;Encrypt=True;
DATABASE_URL=

# --- Image storage ----------------------------------------------------------
# Leave BLANK to store images on local disk (local dev).
# Set to your Azure Blob connection string to store images in the cloud
# (REQUIRED on App Service — its local disk is wiped on restart).
BLOB_CONNECTION_STRING=
BLOB_CONTAINER=images
CAPTURES_DIR=./captures

# --- Security (MUST be changed for production) ------------------------------
# Generate a strong random value, e.g.:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# --- CORS (only needed if you add a web frontend) ---------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=

# --- Server (local only; App Service sets its own) --------------------------
API_PORT=8000
API_HOST=0.0.0.0
